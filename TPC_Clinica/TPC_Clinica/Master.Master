<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Master.Master.cs" Inherits="TPC_Clinica.Master" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Central de Turnos</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Buscador autocomplete -->
    <link href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <!-- FullCalendar v5 compatible -->
<link href='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css' rel='stylesheet' />
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js'></script>

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .main {
            flex: 1;
        }

        .main-content {
            flex: 1;
        }

        h1.titulo-principal {
            font-size: 2.5rem;
            text-align: center;
            font-weight: 600;
            color: #0d6efd; 
            margin-bottom: 30px;
        }

        footer {
            flex-shrink: 0;
            text-align: center;
            padding: 1rem;
            background-color: #f8f9fa;
            border-top: 1px solid #ddd;
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        
        <header>
            <nav class="navbar navbar-expand-lg bg-body-tertiary">
                <div class="container-fluid">
                    <asp:HyperLink ID="hpMeraki" CssClass="navbar-brand" runat="server" NavigateUrl="#">MERAKI</asp:HyperLink>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><asp:HyperLink ID="hlUsuarios" CssClass="nav-link active" NavigateUrl="~/ListadoUsuarios.aspx" Visible="false" runat="server">Usuarios</asp:HyperLink></li>
                            <li class="nav-item"><asp:HyperLink ID="hlMedicos" CssClass="nav-link active" NavigateUrl="~/ListadoMedicos.aspx" Visible="false" runat="server">Medicos</asp:HyperLink></li>
                            <li class="nav-item"><asp:HyperLink ID="hlEspecialidades" CssClass="nav-link active" NavigateUrl="~/ListadoEspecialidades.aspx" Visible="false" runat="server">Especialidades</asp:HyperLink></li>
                            <li class="nav-item"><asp:HyperLink ID="hlPacientes" CssClass="nav-link active" NavigateUrl="~/ListadoPaciente.aspx" Visible="false" runat="server">Pacientes</asp:HyperLink></li>
                            <li class="nav-item"><asp:HyperLink ID="hlTurnos" CssClass="nav-link active" NavigateUrl="~/AsignarTurno2.aspx" Visible="false" runat="server">Turnos</asp:HyperLink></li>
                            <li class="nav-item"><asp:HyperLink ID="hlTipoUsuario" CssClass="nav-link active" NavigateUrl="~/ListadoTipoUsuario.aspx" Visible="false" runat="server">Tipo Usuario</asp:HyperLink></li>
                            <li class="nav-item"><asp:HyperLink ID="hlEstados" CssClass="nav-link active" NavigateUrl="~/ListadoEstados.aspx" Visible="false" runat="server">Estados</asp:HyperLink></li>
                            <li class="nav-item"><asp:HyperLink ID="hlHorarios" CssClass="nav-link active" NavigateUrl="~/HorarioMedico.aspx" Visible="false" runat="server">Mis horarios</asp:HyperLink></li>
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <asp:LinkButton ID="btnCerrarSesion" runat="server" CssClass="nav-link text-danger" OnClick="btnCerrarSesion_Click">
                                    <i class="bi bi-box-arrow-right"></i> Salir
                                </asp:LinkButton>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <div class="main">
            <div class="wrapper">
                <div class="container main-content mt-4">
                    <h1 class="titulo-principal">Central de Turnos</h1>
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
                </div>
            </div>
        </div>

        <footer>
            Clínica 11-A &copy; 2025
        </footer>
    </form>
</body>
</html>
